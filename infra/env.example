# DeeperSeek Environment Configuration
# Copy this to .env and fill in values

# ── REQUIRED ──────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── AUTH / ACCOUNTS ───────────────────────────────────────────────────────────
# Auth mode:
#   'open'        (default) — no login required, preserves legacy single-user behavior
#   'multi_user'  — accounts required; every registration consumes a license key
# AUTH_MODE=multi_user
#
# In multi_user mode, registration REQUIRES a valid, unused license key.
# Generate them on the server:
#
#     node scripts/license.js            # generate 1 license
#     node scripts/license.js 10         # generate 10 licenses
#     node scripts/license.js --list     # list all licenses + usage
#     node scripts/license.js --revoke DS-XXXX-XXXX-XXXX-XXXX
#
# Licenses are stored in runtime/licenses.json (chmod 0600).
# Format: DS-XXXX-XXXX-XXXX-XXXX — one-time use, bound to the account that consumes it.
#
# Legacy single-key auth — if set, requests must include header X-API-Key: <key>
# Honored in BOTH auth modes for backwards compatibility with scripts.
# ACCESS_KEY=your-secret-key

# ── GITHUB OAUTH APP (for user GitHub linking) ────────────────────────────────
# Register an OAuth App at https://github.com/settings/developers
# Callback URL must be: https://<your-domain>/api/github/oauth/callback
# GITHUB_OAUTH_CLIENT_ID=Ov23li...
# GITHUB_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# ── DEEPERSEEK BOT GITHUB IDENTITY ────────────────────────────────────────────
# All AI-generated git commits will be attributed to this GitHub account,
# regardless of which user is currently active. This makes the DeeperSeek
# account appear in Contributors on every repo the AI works in.
#
# These values are hardcoded as fallbacks in the code, but can be overridden here:
DEEPERSEEK_BOT_GITHUB_USERNAME=deeperseeklabs
DEEPERSEEK_BOT_GITHUB_USER_ID=202067617
DEEPERSEEK_BOT_GITHUB_NAME=DeeperSeek-v73.5

# ── OPTIONAL OVERRIDES ────────────────────────────────────────────────────────
# DEEPERSEEK_BACKEND_URL=http://localhost:3000
