{
  "agents": {
    "orchestrator": {
      "model": "deepseek-reasoner",
      "temperature": 0.3,
      "max_tokens": 8192,
      "identity_file": "ai/agents/orchestrator/identity.txt",
      "can_spawn": true,
      "tools": ["all"],
      "description": "Master orchestrator — decomposes tasks, routes to agents, synthesizes results"
    },
    "planner": {
      "model": "deepseek-reasoner",
      "temperature": 0.2,
      "max_tokens": 4096,
      "identity_file": "ai/agents/planner/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "fs_tree", "memory_get", "memory_search", "workspace_load"],
      "description": "Deep planning agent — produces structured execution plans"
    },
    "worker_general": {
      "model": "deepseek-chat",
      "temperature": 0.6,
      "max_tokens": 4096,
      "identity_file": "ai/agents/worker_general/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "fs_write", "fs_search", "fs_tree", "run_python", "run_bash", "web_fetch", "web_search", "memory_store", "memory_get"],
      "description": "General purpose worker for most tasks"
    },
    "worker_code": {
      "model": "deepseek-chat",
      "temperature": 0.4,
      "max_tokens": 8192,
      "identity_file": "ai/agents/worker_code/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "fs_write", "fs_search", "fs_tree", "fs_move", "run_python", "run_bash", "run_node", "code_analyzer", "repo_scanner", "bug_detector", "memory_store", "memory_get"],
      "description": "Specialized code agent — reads, writes, debugs, tests code"
    },
    "worker_research": {
      "model": "deepseek-chat",
      "temperature": 0.7,
      "max_tokens": 4096,
      "identity_file": "ai/agents/worker_research/identity.txt",
      "can_spawn": false,
      "tools": ["web_fetch", "web_search", "fs_read", "fs_write", "memory_store", "memory_search", "memory_get"],
      "description": "Research agent — searches, reads, summarizes information"
    },
    "worker_fileops": {
      "model": "deepseek-chat",
      "temperature": 0.2,
      "max_tokens": 2048,
      "identity_file": "ai/agents/worker_fileops/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "fs_write", "fs_search", "fs_tree", "fs_move", "fs_delete", "workspace_create", "workspace_load", "workspace_index"],
      "description": "File operations specialist"
    },
    "worker_image": {
      "model": "deepseek-chat",
      "temperature": 0.5,
      "max_tokens": 2048,
      "identity_file": "ai/agents/worker_image/identity.txt",
      "can_spawn": false,
      "tools": ["image_ingest", "image_describe", "screenshot_analyze", "ui_parser", "fs_read", "fs_write"],
      "description": "Image and visual analysis agent"
    },
    "critic": {
      "model": "deepseek-chat",
      "temperature": 0.3,
      "max_tokens": 2048,
      "identity_file": "ai/agents/critic/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "memory_get"],
      "description": "Quality evaluator — scores outputs and finds issues"
    },
    "socrates": {
      "model": "deepseek-reasoner",
      "temperature": 0.2,
      "max_tokens": 4096,
      "identity_file": "ai/agents/socrates/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "memory_get", "memory_search"],
      "description": "Validation agent — finds contradictions, verifies logic and correctness"
    },
    "synthesizer": {
      "model": "deepseek-chat",
      "temperature": 0.5,
      "max_tokens": 8192,
      "identity_file": "ai/agents/synthesizer/identity.txt",
      "can_spawn": false,
      "tools": ["fs_read", "memory_get"],
      "description": "Result synthesizer — aggregates agent outputs into final answer"
    }
  },

  "routing": {
    "code_keywords": ["code", "script", "function", "bug", "debug", "implement", "refactor", "test", "build", "compile", "repository", "repo", "git"],
    "research_keywords": ["research", "find", "search", "what is", "how does", "explain", "summarize", "analyze", "gather", "collect"],
    "fileops_keywords": ["file", "folder", "directory", "move", "copy", "delete", "rename", "organize", "unzip", "extract"],
    "image_keywords": ["image", "screenshot", "photo", "picture", "visual", "diagram", "ui", "design"],
    "default_agent": "worker_general"
  }
}
